{#- Copy of the datamodel-code-generator dataclass template. Changes: fields renamed in Python
    (e.g. `Block stats` -> `Block_stats`, `from` -> `from_`) keep their original key in
    `field(metadata={alias_metadata_key: ...})`, the same way msgspec models keep it in `field(name=...)`
    (`alias_metadata_key` is `model_options.ALIAS_METADATA_KEY`), and classes without a description get a generic
    docstring (`dataclass` computes the signature of classes without a docstring - slow imports), so classes without
    fields need no `pass`. -#}
{% for decorator in decorators -%}
{{ decorator }}
{% endfor -%}
{%- set args = [] %}
{%- for k, v in (dataclass_arguments or {}).items() %}
    {%- if v is not none and v is not false %}
        {%- set _ = args.append(k ~ '=' ~ (v|pprint)) %}
    {%- endif %}
{%- endfor %}
{%- if args %}
@dataclass({{ args | join(', ') }})
{%- else %}
@dataclass
{%- endif %}
{%- if base_class %}
class {{ class_name }}({{ base_class }}):
{%- else %}
class {{ class_name }}:
{%- endif %}
{%- if description %}
    """
    {{ description | escape_docstring | indent(4) }}
    """
{%- else %}
    """The {{ class_name }} model."""
{%- endif %}
{%- for field in fields -%}
    {%- if field.alias and field.alias != field.name %}
    {%- set metadata = 'metadata={' ~ (alias_metadata_key|pprint) ~ ': ' ~ (field.alias|pprint) ~ '}' %}
    {%- if field.field and field.field.startswith('field(') %}
    {{ field.name }}: {{ field.type_hint }} = {{ field.field[:-1] }}, {{ metadata }})
    {%- elif field.field %}
    {{ field.name }}: {{ field.type_hint }} = field(default={{ field.field }}, {{ metadata }})
    {%- elif field.required or (field.represented_default == 'None' and field.strip_default_none) %}
    {{ field.name }}: {{ field.type_hint }} = field({{ metadata }})
    {%- else %}
    {{ field.name }}: {{ field.type_hint }} = field(default={{ field.represented_default }}, {{ metadata }})
    {%- endif %}
    {%- elif field.field %}
    {{ field.name }}: {{ field.type_hint }} = {{ field.field }}
    {%- else %}
    {{ field.name }}: {{ field.type_hint }}
    {%- if not (field.required or (field.represented_default == 'None' and field.strip_default_none))
            %} = {{ field.represented_default }}
    {%- endif -%}
    {%- endif %}
    {%- if field.docstring %}
    """
    {{ field.docstring | escape_docstring | indent(4) }}
    """
{%- if field.use_inline_field_description and not loop.last %}

{% endif %}
    {%- elif field.inline_field_docstring %}
    {{ field.inline_field_docstring }}
{%- if not loop.last %}

{% endif %}
    {%- endif %}
{%- endfor -%}
